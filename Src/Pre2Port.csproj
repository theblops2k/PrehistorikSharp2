<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Windows Forms is used ONLY for the folder-selection dialog of the launcher (Game\Launcher\FolderPicker.cs); the output stays in bin\<cfg>\net10.0 like before. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0\</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- unsafe: only GameOptionsPostFilters.cs (Raylib.SetShaderValue with stackalloc uniforms, as in CoolSpotPort) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>pre2port.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- keep Raylib's Color/Rectangle/Image/... unambiguous: no implicit System.Drawing / System.Windows.Forms usings -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>
